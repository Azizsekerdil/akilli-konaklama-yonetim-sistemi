# ============================================================
#  Akilli Konaklama Yonetim Sistemi - Ornek ortam degiskenleri
# ============================================================
#  KULLANIM:
#    1) Bu dosyayi ".env" adiyla kopyalayin       -> copy .env.example .env
#    2) Degerleri kendi ortaminiza gore doldurun
#    3) .env DOSYASINI ASLA GIT'E EKLEMEYIN (.gitignore icinde tanimli)
#
#  GUVENLIK NOTU:
#    API anahtarlari icin tercih edilen yontem Windows Credential Manager
#    (keyring) kullanmaktir. Uygulama once keyring'e bakar, bulamazsa .env
#    degerini kullanir. .env yalnizca GELISTIRME ortami icindir.
#
#    Keyring'e anahtar yazmak icin (uygulama icinden Ayarlar > Yapay Zeka):
#      Ayarlar ekranindaki "API Anahtarini Kaydet" dugmesini kullanin.
#    veya komut satirindan:
#      python -m app.scripts.set_secret nvidia_api_key
# ============================================================

# ------------------------------------------------------------
# UYGULAMA
# ------------------------------------------------------------
HOTEL_APP_ENV=development          # development | testing | production
HOTEL_APP_DEBUG=true
HOTEL_APP_LANGUAGE=tr              # tr | en
HOTEL_APP_THEME=dark               # light | dark | system

# ------------------------------------------------------------
# VERITABANI
# ------------------------------------------------------------
# SQLite (varsayilan, ilk calistirma icin):
HOTEL_DB_URL=sqlite:///data/hotel.db
#
# PostgreSQL (uretim secenegi) - ornek:
# Asagidaki satirdaki KULLANICI ve PAROLA yer tutucularini kendi
# degerlerinizle degistirin. Gercek parolayi bu dosyaya DEGIL, .env
# dosyasina yazin (.env git tarafindan izlenmez).
# HOTEL_DB_URL=postgresql+psycopg://KULLANICI:PAROLA@localhost:5432/hotel
HOTEL_DB_ECHO=false                # true yapilirsa tum SQL loglanir (gelistirme)

# ------------------------------------------------------------
# GUVENLIK
# ------------------------------------------------------------
# Oturum imzalama anahtari. URETIMDE MUTLAKA DEGISTIRIN.
# Uretmek icin: python -c "import secrets; print(secrets.token_urlsafe(64))"
HOTEL_SECRET_KEY=DEGISTIRIN-bu-deger-yalnizca-ornektir
HOTEL_SESSION_TIMEOUT_MINUTES=30
HOTEL_MAX_FAILED_LOGINS=5
HOTEL_LOCKOUT_MINUTES=15
HOTEL_PASSWORD_MIN_LENGTH=10

# ------------------------------------------------------------
# API SUNUCUSU (FastAPI)
# ------------------------------------------------------------
HOTEL_API_HOST=127.0.0.1
HOTEL_API_PORT=8760
HOTEL_API_ENABLED=true
HOTEL_API_RATE_LIMIT_PER_MINUTE=120
HOTEL_API_CORS_ORIGINS=http://127.0.0.1:8760

# ------------------------------------------------------------
# LOGLAMA
# ------------------------------------------------------------
HOTEL_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
HOTEL_LOG_DIR=logs
HOTEL_LOG_JSON=false               # true = yapilandirilmis JSON log
HOTEL_LOG_RETENTION_DAYS=30

# ------------------------------------------------------------
# YAPAY ZEKA - GENEL
# ------------------------------------------------------------
HOTEL_AI_ENABLED=true
HOTEL_AI_PRIMARY_PROVIDER=lmstudio     # lmstudio | openai | nvidia | anthropic | mock
HOTEL_AI_FALLBACK_PROVIDER=mock        # birincil basarisiz olursa devreye girer
HOTEL_AI_DEFAULT_TIMEOUT=120           # saniye
HOTEL_AI_DEFAULT_TEMPERATURE=0.3
HOTEL_AI_DEFAULT_MAX_TOKENS=2048
HOTEL_AI_TRACK_COST=true

# ------------------------------------------------------------
# YAPAY ZEKA - LM STUDIO (yerel, ucretsiz)
# ------------------------------------------------------------
# Not: Adres tahmin edilmez; uygulama baglanti testiyle dogrular.
HOTEL_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
HOTEL_LMSTUDIO_API_KEY=lm-studio        # LM Studio anahtar kontrolu yapmaz, dolgu deger
HOTEL_LMSTUDIO_CHAT_MODEL=google/gemma-4-12b-qat
HOTEL_LMSTUDIO_VISION_MODEL=qwen/qwen3-vl-8b
HOTEL_LMSTUDIO_MATH_MODEL=qwen2.5-math-7b-instruct
HOTEL_LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# ------------------------------------------------------------
# YAPAY ZEKA - NVIDIA (build.nvidia.com)
# ------------------------------------------------------------
# ANAHTARI TERCIHEN KEYRING'E KAYDEDIN. Buraya yazarsaniz .env git'e girmez
# ama yine de diskte duz metin olur.
HOTEL_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
HOTEL_NVIDIA_API_KEY=
HOTEL_NVIDIA_CHAT_MODEL=

# ------------------------------------------------------------
# YAPAY ZEKA - OPENAI UYUMLU (opsiyonel)
# ------------------------------------------------------------
HOTEL_OPENAI_BASE_URL=https://api.openai.com/v1
HOTEL_OPENAI_API_KEY=
HOTEL_OPENAI_CHAT_MODEL=

# ------------------------------------------------------------
# YAPAY ZEKA - ANTHROPIC (opsiyonel)
# ------------------------------------------------------------
HOTEL_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
HOTEL_ANTHROPIC_API_KEY=
HOTEL_ANTHROPIC_CHAT_MODEL=

# ------------------------------------------------------------
# AI GELISTIRME MERKEZI (kisitli terminal)
# ------------------------------------------------------------
HOTEL_DEVCENTER_ENABLED=true
# ORNEK deger. Kendi kurulum klasorunuzun TAM yolunu yazin; AI Gelistirme
# Merkezi bu klasorun disina cikamaz.
HOTEL_DEVCENTER_ROOT=C:\AkilliKonaklama
HOTEL_DEVCENTER_REQUIRE_APPROVAL=true  # false yapilmasi ONERILMEZ
HOTEL_DEVCENTER_COMMAND_TIMEOUT=300
HOTEL_DEVCENTER_GIT_CHECKPOINT=true

# ------------------------------------------------------------
# YEDEKLEME
# ------------------------------------------------------------
HOTEL_BACKUP_DIR=backups
HOTEL_BACKUP_RETENTION=14

# ------------------------------------------------------------
# TURKIYE'YE OZEL ENTEGRASYONLAR
# ------------------------------------------------------------
# UYARI: Bu entegrasyonlar HENUZ TAMAMLANMAMISTIR. Yalnizca arayuz
# (interface) katmani hazirdir. Gercek servis saglayici bilgilerinizi
# girmeden ve entegrasyonu tamamlamadan URETIMDE KULLANMAYIN.
# Ayrintilar: docs/ROADMAP.md
HOTEL_EFATURA_ENABLED=false
HOTEL_EFATURA_PROVIDER=
HOTEL_EFATURA_BASE_URL=
HOTEL_KBS_ENABLED=false                # Kimlik Bildirim Sistemi
HOTEL_KBS_BASE_URL=
